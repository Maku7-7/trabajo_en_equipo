#include <bits/stdc++.h>
using namespace std;

int main() {
    double x, y, z;
    cin >> x >> y >> z;

    double arriba = pow(2.0 * y + z, 2.8) - z;
    double abajo = x + y - (x / z);

    double r = arriba / abajo;

    cout.setf(ios::fixed);
    cout.precision(6);
    cout << r;

    return 0;
}